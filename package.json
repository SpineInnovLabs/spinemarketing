{
  "name": "spineworkspace-marketing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsx scripts/generate-rss.ts && next build --webpack",
    "dev": "next dev -p 5010 -H 0.0.0.0",
    "lint": "eslint .",
    "start": "next start -p 5010 -H 0.0.0.0",
    "wrangler:login": "env -u CLOUDFLARE_API_TOKEN -u CLOUDFLARE_ACCOUNT_ID wrangler login",
    "wrangler:whoami": "env -u CLOUDFLARE_API_TOKEN -u CLOUDFLARE_ACCOUNT_ID wrangler whoami",
    "deploy:dev": "env -u CLOUDFLARE_API_TOKEN wrangler deploy --env dev",
    "deploy:test": "env -u CLOUDFLARE_API_TOKEN wrangler deploy --env test",
    "deploy:prod": "env -u CLOUDFLARE_API_TOKEN wrangler deploy --env prod",
    "preview": "env -u CLOUDFLARE_API_TOKEN wrangler versions upload",
    "content:migrate": "tsx scripts/migrate-blog-to-sanity.ts",
    "sanity:dev": "sanity dev",
    "sanity:deploy": "sanity deploy"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.12.0",
    "framer-motion": "^11.18.0",
    "lucide-react": "^0.454.0",
    "next": "16.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "sanity": "^3.99.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "@firebase/util",
      "protobufjs",
      "bufferutil",
      "utf-8-validate",
      "core-js"
    ],
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
