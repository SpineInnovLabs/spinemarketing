{
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      { "source": "/docs", "destination": "https://docs.spineworkspace.com/", "type": 301 },
      { "source": "/changelog", "destination": "https://changelog.spineworkspace.com/", "type": 301 },
      { "source": "/platform/the-adaptive-spine", "destination": "/platform/spine-fabric", "type": 301 },
      { "source": "/ai", "destination": "/twin", "type": 301 },
      { "source": "/why", "destination": "/about", "type": 301 },
      { "source": "/product", "destination": "/spineworkspace", "type": 301 },
      { "source": "/product/the-adaptive-workspace", "destination": "/adaptive-workspace", "type": 301 },
      { "source": "/product/approval-gate-twin", "destination": "/governance", "type": 301 },
      { "source": "/product/how-it-works", "destination": "/twin", "type": 301 },
      { "source": "/product/security", "destination": "/security", "type": 301 },
      { "source": "/account-success", "destination": "/solutions/customer-success", "type": 301 },
      { "source": "/business-ops", "destination": "/solutions/finance", "type": 301 },
      { "source": "/personal-ops", "destination": "/solutions/individual", "type": 301 },
      { "source": "/solutions/revops", "destination": "/solutions/sales", "type": 301 },
      { "source": "/solutions/operations", "destination": "/solutions/finance", "type": 301 },
      { "source": "/use-cases", "destination": "/solutions", "type": 301 },
      { "source": "/use-cases/sales", "destination": "/solutions/sales", "type": 301 },
      { "source": "/use-cases/customer-success", "destination": "/solutions/customer-success", "type": 301 },
      { "source": "/use-cases/operations", "destination": "/solutions/finance", "type": 301 },
      { "source": "/use-cases/founders-and-leaders", "destination": "/solutions/founders", "type": 301 },
      { "source": "/use-cases/teams", "destination": "/solutions/individual", "type": 301 },
      { "source": "/integrations", "destination": "/developers", "type": 301 },
      { "source": "/services", "destination": "/contact", "type": 301 },
      { "source": "/spine", "destination": "/platform/spine-fabric", "type": 301 },
      { "source": "/resources", "destination": "/blog", "type": 301 }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|svg|png|jpg|jpeg|gif|ico|woff|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  }
}
